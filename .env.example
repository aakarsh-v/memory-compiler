# Environment & Networking
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memory_compiler
REDIS_URL=redis://localhost:6379/0
ENABLE_ASYNC_WORKER=false

# Storage & Upload Bounds
MEDIA_ROOT=data/media
MAX_UPLOAD_MB=500
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".mkv",".webm",".avi"]

# Video Pipeline
FRAME_SAMPLE_SECONDS=2.0

# Multimodal Embeddings (Mock provider for tests / CPU dev)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_ID=mock-clip-vit-b32
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
VECTOR_DIMENSION=512
